# Ambiente de TESTES automatizados. Sem segredos reais. A suíte (tests/conftest.py) recusa rodar
# se o banco não terminar em "_test", porque ela faz TRUNCATE nas tabelas.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/df_remuneration_test
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@postgres:5432/df_remuneration_test
# Redis em outro índice (15) para o cache dos testes não limpar o cache do app (índice 0)
REDIS_URL=redis://redis:6379/15
APP_ENV=testing
LOG_LEVEL=WARNING
SUPABASE_URL=https://mock.supabase.co
SUPABASE_JWT_SECRET=mock-secret-for-tests-1234567890
SUPABASE_JWKS_URL=
SUPABASE_SERVICE_ROLE_KEY=mock-service-role
ADMIN_EMAILS=test@example.com
CORS_ORIGINS=*
