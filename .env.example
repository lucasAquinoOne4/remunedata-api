# ─── Banco de Dados ────────────────────────────────────────────────────────────
# URL de conexão assíncrona para SQLAlchemy 2.x (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/df_remuneration

# URL de conexão síncrona para Alembic (migrations)
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@postgres:5432/df_remuneration

# Credenciais do PostgreSQL (usadas pelo docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=df_remuneration

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Aplicação ─────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ─── API do Portal da Transparência ─────────────────────────────────────────────
# URL base da API (não deve ser alterada)
TRANSPARENCIA_API_BASE_URL=https://www.transparencia.df.gov.br/api
# Tamanho de página máximo validado (não alterar sem nova validação)
TRANSPARENCIA_PAGE_SIZE=150
# Timeout em segundos para requisições HTTP
TRANSPARENCIA_TIMEOUT_SECONDS=30
# Cadência sustentável medida (acima disso o portal responde 429 e bloqueia por minutos).
# Ver docs/adr/0001-convivencia-com-o-portal-do-df.md
TRANSPARENCIA_BATCH_SIZE=1
TRANSPARENCIA_REQUEST_DELAY_SECONDS=2
TRANSPARENCIA_CLIENT_ID=remunedata

# ─── Supabase Auth ─────────────────────────────────────────────────────────────
# URL do projeto Supabase
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Segredo JWT do Supabase (para validar tokens no backend)
SUPABASE_JWT_SECRET=sua_chave_secreta_jwt_hs256


# ─── Pagamento (AbacatePay v2) ─────────────────────────────────────────────────
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
# Chave pública de assinatura de webhook (opcional; da documentação da AbacatePay)
ABACATEPAY_PUBLIC_KEY=
ABACATEPAY_METHODS=PIX,CARD
FRONT_URL=http://localhost:5173

# ─── Admin ─────────────────────────────────────────────────────────────────────
# E-mails (separados por vírgula) com acesso de administrador. Vazio = ninguém é admin.
ADMIN_EMAILS=

# ─── Executivo federal (Portal da Transparência) ─────────────────────────────
# A carga mensal usa o ZIP público (sem chave). A chave só enriquece o perfil (ficha) via API.
PORTAL_FEDERAL_API_KEY=
FEDERAL_SYNC_MONTHS=2

# Prefixo secreto das rotas de admin: precisa ser IGUAL ao VITE_ADMIN_PATH do frontend
ADMIN_PATH_PREFIX=admin-secret-dashboard
